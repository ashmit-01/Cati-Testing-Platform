# Environment
TEST_ENV=staging

# CATI endpoints - fill with authorized environment values
FRONTEND_URL=
BACKEND_URL=
AI_ENGINE_URL=
AI_ENGINE_WS_URL=

# Dedicated test account
TEST_EMAIL=
TEST_PASSWORD=

# Safety guards for live side-effects (telephony / payments)
# Leave as false to prevent any accidental real calls or real financial transactions
ALLOW_REAL_CALLS=false
ALLOW_LIVE_PAYMENTS=false

# AI/Voice behavior tests (test-engine/ai) - see test-engine/ai/AI_TEST_SCENARIOS.md
# TEST_AGENT_ID: an agent in the target environment whose greeting, knowledge
# base, language support and guardrail policy are known to the QA team.
# Tests that need it are skipped (not failed) when it is unset.
TEST_AGENT_ID=

# Optional: a phrase known to exist in TEST_AGENT_ID's knowledge base
# (e.g. a configured service name), used by rag.spec.js to check the
# agent's reply is actually grounded in that content. Skipped if unset.
TEST_KB_KEYWORD=

# Optional: a distinctive fragment of TEST_AGENT_ID's configured greeting,
# used by greeting.spec.js for an exact-ish match instead of a loose
# "does this sound like a greeting" heuristic. Falls back to the
# heuristic if unset.
TEST_GREETING_FRAGMENT=

# Optional: WebSocket test timeouts (milliseconds). Sensible defaults are
# used if unset - see test-engine/websocket/data/ws.config.js.
WS_CONNECT_TIMEOUT_MS=
WS_MESSAGE_TIMEOUT_MS=
WS_IDLE_TIMEOUT_MS=
