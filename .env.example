# ==============================================================================
# CATI QA Test Platform — Environment Configuration
# ==============================================================================

# Target Environment identifier: 'staging' | 'production' | 'local'
TEST_ENV=staging

# ------------------------------------------------------------------------------
# Target System Under Test (SUT) Endpoints
# ------------------------------------------------------------------------------
# Frontend web portal URL (used for browser UI and E2E tests)
FRONTEND_URL=https://usecati.com

# CATI Backend API URL (used for REST API tests: /api/auth, /api/agents, /api/ai-engine)
BACKEND_URL=http://localhost:5000

# External AI Engine Host (used for direct speech/TTS/health checks)
AI_ENGINE_URL=https://fucr8ewyudjjbqlxhajoahpn.200.234.39.243.sslip.io

# External AI Engine WebSocket URL (used for real-time speech/audio stream tests)
AI_ENGINE_WS_URL=wss://fucr8ewyudjjbqlxhajoahpn.200.234.39.243.sslip.io

# ------------------------------------------------------------------------------
# Dedicated QA Test Credentials
# ------------------------------------------------------------------------------
# Dedicated non-production test account used by auth.setup.js and API fixtures
TEST_EMAIL=
TEST_PASSWORD=

# ------------------------------------------------------------------------------
# Telephony and Financial Safety Guards
# ------------------------------------------------------------------------------
# CRITICAL: Leave as false to strictly prevent any real telephone calls
ALLOW_REAL_CALLS=false

# CRITICAL: Leave as false to prevent any real payment or checkout transactions
ALLOW_LIVE_PAYMENTS=false

# ------------------------------------------------------------------------------
# AI Engine and Voice Testing Configuration
# ------------------------------------------------------------------------------
# Optional: Pre-existing Agent ID in the target environment.
# If omitted or left empty, the test suite automatically provisions an isolated
# temporary test agent per test and automatically cleans it up after completion.
TEST_AGENT_ID=

# Optional: Distinctive keyword or phrase in TEST_AGENT_ID's knowledge base
# Used by rag.spec.js to assert retrieval grounding. If omitted, falls back to
# generic domain answer validation.
TEST_KB_KEYWORD=

# Optional: Distinctive fragment of the configured greeting phrase
# Used by greeting.spec.js for exact-match verification. If omitted, falls back
# to standard greeting terminology heuristics.
TEST_GREETING_FRAGMENT=

# ------------------------------------------------------------------------------
# WebSocket Test Timeouts (Milliseconds)
# ------------------------------------------------------------------------------
WS_CONNECT_TIMEOUT_MS=8000
WS_MESSAGE_TIMEOUT_MS=10000
WS_IDLE_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Reporting & Output
# ------------------------------------------------------------------------------
PLAYWRIGHT_JSON_OUTPUT_FILE=playwright-results.json

# ------------------------------------------------------------------------------
# AI Failure Analysis (QA backend; goes in backend/.env, see backend/.env.example)
# ------------------------------------------------------------------------------
# When a test fails, its TEXT evidence is sent to an LLM, which returns a
# probable cause and a suggested fix. Screenshots/videos are NOT analysed.
# The feature is optional: without LLM_API_KEY, test runs work as normal and the
# failure's AI analysis shows an ERROR with a retry button.
AI_ANALYSIS_ENABLED=true
# 'anthropic' (default) or 'openai' (any OpenAI-compatible chat completions API)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides (provider defaults are used when blank)
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
AI_ANALYSIS_CONCURRENCY=2

