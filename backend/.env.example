# Copy to backend/.env. Never commit .env or share keys.

PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/cati-qa
JWT_SECRET=change-me
# Dashboard origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
# 'mock' (simulated results) or 'playwright' (real tests)
TEST_EXECUTION_MODE=mock

# ---- AI failure analysis (text evidence only) ----
AI_ANALYSIS_ENABLED=true
# 'anthropic' or 'openai' (any OpenAI-compatible chat API)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
AI_ANALYSIS_CONCURRENCY=2

# Dashboard login (there is no sign-up page): npm run create-admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Output token limit; use 4096+ for Gemini "thinking" models
LLM_MAX_TOKENS=2048
